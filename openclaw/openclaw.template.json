{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "local-personal-assistant"
    }
  },
  "logging": { "level": "info" },
  "agents": {
    "defaults": {
      "model": { "primary": "ollama/qwen2.5:7b" },
      "thinkingDefault": "off",
      "heartbeat": { "every": "0m" },
      "timeoutSeconds": 120,
      "compaction": { "enabled": false, "notifyUser": false, "keepRecentTokens": 1500, "recentTurnsPreserve": 1 },
      "systemAgent": { "agentId": "main" }
    },
    "list": [
      {
        "id": "main",
        "default": true,
        "name": "WhatsApp Orchestrator",
        "workspace": "__ROOT__/.openclaw/workspace-main",
        "agentDir": "__ROOT__/.openclaw/agents/main/agent"
      },
      {
        "id": "tasks",
        "name": "Task Agent",
        "workspace": "__ROOT__/.openclaw/workspace-tasks",
        "agentDir": "__ROOT__/.openclaw/agents/tasks/agent"
      },
      {
        "id": "reminders",
        "name": "Reminder Agent",
        "workspace": "__ROOT__/.openclaw/workspace-reminders",
        "agentDir": "__ROOT__/.openclaw/agents/reminders/agent"
      },
      {
        "id": "learning",
        "name": "Research and Learning Agent",
        "workspace": "__ROOT__/.openclaw/workspace-learning",
        "agentDir": "__ROOT__/.openclaw/agents/learning/agent"
      },
      {
        "id": "tutor",
        "name": "Daily Tutor",
        "workspace": "__ROOT__/.openclaw/workspace-tutor",
        "agentDir": "__ROOT__/.openclaw/agents/tutor/agent"
      },
      {
        "id": "meetings",
        "name": "Meeting Agent",
        "workspace": "__ROOT__/.openclaw/workspace-meetings",
        "agentDir": "__ROOT__/.openclaw/agents/meetings/agent"
      }
    ]
  },
  "bindings": [
    { "agentId": "main", "match": { "channel": "whatsapp" } }
  ],
  "tools": {
    "agentToAgent": {
      "enabled": true,
      "allow": ["main", "tasks", "reminders", "learning", "tutor", "meetings"]
    }
  },
  "channels": {
    "whatsapp": {
      "dmPolicy": "allowlist",
      "allowFrom": ["+918698814230"],
      "sendReadReceipts": true,
      "mediaMaxMb": 50,
      "pluginHooks": { "messageReceived": true }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "ollama": {
        "baseUrl": "http://127.0.0.1:11434",
        "apiKey": "ollama-local",
        "api": "ollama",
        "models": [
          {
            "id": "qwen2.5:7b",
            "name": "Qwen2.5 7B Instruct",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 8192,
            "maxTokens": 2048,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "params": { "num_ctx": 8192, "keep_alive": "24h", "temperature": 0.4 }
          },
          {
            "id": "qwen3:8b",
            "name": "Qwen3 8B",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 4096,
            "maxTokens": 1536,
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "params": { "num_ctx": 4096, "keep_alive": "24h", "temperature": 0.4 }
          }
        ]
      }
    }
  },
  "session": {
    "reset": { "mode": "idle", "idleMinutes": 5 },
    "resetByType": { "direct": { "mode": "idle", "idleMinutes": 5 } }
  },
  "plugins": {
    "load": { "paths": ["__ROOT__/openclaw/plugins/pa-inbox"] },
    "entries": {
      "whatsapp": { "enabled": true },
      "ollama": { "enabled": true },
      "pa-inbox": { "enabled": true, "hooks": { "allowConversationAccess": true } }
    }
  }
}
